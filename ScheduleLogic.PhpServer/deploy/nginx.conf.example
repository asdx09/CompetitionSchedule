# ---------------------------------------------------------------------------
# ScheduleLogic - production deployment behind nginx + PHP-FPM (Linux)
#
#  - nginx serves the static files of the built Angular client
#  - /api and /admin -> PHP-FPM (public/index.php)
#  - everything else (Angular routes) -> index.html
#
# This runs instead of .NET Kestrel, on the same domain and port.
# PHP side: APP_ENV=Production (default); secrets can also be given as
# environment variables, e.g. Database__Password, MailSend__Password.
# ---------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    server_name schedulelogic.hu;

    ssl_certificate     /etc/letsencrypt/live/schedulelogic.hu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/schedulelogic.hu/privkey.pem;

    # output of the Angular build (ng build)
    root /var/www/schedulelogic/wwwroot;
    index index.html;

    client_max_body_size 10m;

    location ~ ^/(api|admin)(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/schedulelogic/ScheduleLogic.PhpServer/public/index.php;
        fastcgi_param HTTPS on;
        fastcgi_param APP_ENV Production;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name schedulelogic.hu;
    return 301 https://$host$request_uri;
}
