{
  "_comment": "PHP-specifikus beállítások. Másold appsettings.json néven (gitignore-olt). Az adatbázis, levelezés, URL-ek és AdminAuth a ../ScheduleLogic.Server/appsettings*.json-ból (és Developmentben a .NET User Secrets-ből) jönnek - itt csak felülírni kell, ha mást szeretnél.",

  "AppSettings": {
    "TimeZone": "Europe/Budapest",
    "PublicUrl": "https://schedulelogic.hu",
    "ExportDateFormat": "Y-m-d H:i:s"
  },

  "Cors": {
    "AllowedOrigins": [ "https://schedulelogic.hu" ]
  },

  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },

  "Solver": {
    "CallbackSecret": "",
    "TimeoutSeconds": 100
  },

  "RateLimiting": {
    "Enabled": true,
    "Login":         { "PermitLimit": 20, "WindowSeconds": 300 },
    "Register":      { "PermitLimit": 5,  "WindowSeconds": 900 },
    "EmailSending":  { "PermitLimit": 5,  "WindowSeconds": 900 },
    "ResetPassword": { "PermitLimit": 10, "WindowSeconds": 900 },
    "AdminLogin":    { "PermitLimit": 5,  "WindowSeconds": 900 }
  }
}
